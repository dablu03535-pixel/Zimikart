# Copy to .env (never commit .env). Placeholders only - no secrets belong in a Vite frontend:
# every VITE_* variable is bundled into public JavaScript.

# Provisional brand name shown across the UI
VITE_BRAND_NAME="Zimikart"

# Public support address shown on the contact page (placeholder)
VITE_SUPPORT_EMAIL="support@your-domain.example"

# Base URL of the future PHP REST API (used only when VITE_USE_MOCK_API=false)
VITE_API_BASE_URL="http://localhost:8080/api/v1"

# "true" = use bundled sample data. "false" = call VITE_API_BASE_URL (backend does not exist yet)
VITE_USE_MOCK_API="true"
