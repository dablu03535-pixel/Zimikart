{
  "name": "zimikart",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Stage 1 frontend for a multi-vendor marketplace (mock data, no backend).",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
